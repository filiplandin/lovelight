# Copy to .env and fill in. Every variable is optional: the demo runs fully offline without any of them.

# Claude extraction. Empty -> deterministic fallback to data/generated/gold.json ("gold-cache" mode).
ANTHROPIC_API_KEY=

# Gmail IMAP intake (Google app password, not your account password). Empty GMAIL_USER disables the inbox poller.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Comma-separated sender addresses/domains whose mail may be auto-posted; everything else needs review.
SENDER_ALLOWLIST=

# SQLite file for runtime state. Default: data/lovelight.db
LOVELIGHT_DB=

# Max documents extracted concurrently per upload batch (min 3).
LOVELIGHT_MAX_CONCURRENCY=4

# Light read-only connector (optional; disabled when the key is empty). API contract unverified, see SECURITY.md.
LIGHT_API_KEY=
# LIGHT_API_URL=https://api.light.inc
LIGHT_API_URL=
